---
import {reviews,googleReviewUrl,googleProfileUrl} from '../data/reviews.js';
const launch=import.meta.env.PUBLIC_SITE_LAUNCH==='true';
const visible=reviews.filter(review=>!launch||review.publicApproved);
---
{visible.length>0&&<section class="review-section container" aria-labelledby="reviews-title" aria-roledescription="carousel"><div class="review-heading"><div><span class="eyebrow">From the people we bake for</span><h2 id="reviews-title">A little cookie. <em>A lovely response.</em></h2></div>{visible.length>1&&<div class="review-controls"><button id="reviews-prev" aria-label="Previous review">←</button><button id="reviews-pause" aria-pressed="false">Pause carousel</button><button id="reviews-next" aria-label="Next review">→</button></div>}</div><div class="review-track" id="review-track" tabindex="0" aria-label="Customer reviews — swipe or use the arrow buttons">{visible.map((review,i)=><article class="review-card" role="group" aria-roledescription="slide" aria-label={`${i+1} of ${visible.length}`}><div class="review-platform">{review.rating?<span aria-label={`${review.rating} out of 5 stars`}>★★★★★</span>:<span>Recommends Home is Cookie</span>}</div><blockquote>“{review.quote}”</blockquote><cite>{review.name}</cite><p class="small">{review.source}</p><a class="review-source" href={review.sourceUrl} target="_blank" rel="noopener">{review.sourceLinkLabel} ↗</a></article>)}</div><div class="review-footer"><a href="https://www.facebook.com/homeiscookie/reviews" target="_blank" rel="noopener">See Facebook reviews ↗</a>{googleProfileUrl&&<a href={googleProfileUrl} target="_blank" rel="noopener">Read our Google reviews ↗</a>}{googleReviewUrl&&<a href={googleReviewUrl} target="_blank" rel="noopener">Share your experience ↗</a>}</div></section>}
