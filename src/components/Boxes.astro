---
import {boxes} from '../data/site.js';
const {estimator=false}=Astro.props;
---
<div class="box-grid">{boxes.map((box,i)=><article class="box-option"><span class="eyebrow">0{i+1} / THE {box.name.toUpperCase()}</span><h3>{box.name}</h3><p class="box-price">${box.price}<span> / box</span></p><p class="box-content">1 stuffed cookie<br/><strong>+ {box.minis} mini cookies</strong></p><p class="small">10-box minimum · ${box.price*10} merchandise</p><a class="text-link" href={'/order/?type=corporate&box='+box.name+'&quantity=10'}>Choose {box.name} <span>↗</span></a></article>)}</div>
<p class="small">At least two weeks’ notice · Standard packaging included · Corporate delivery quoted separately.</p>
{estimator&&<form class="estimator" id="box-estimator"><div><h3>Plan your gift list.</h3><p>A quick merchandise estimate for one box style.</p></div><label>Box style<select name="tier" id="box-tier">{boxes.map(box=><option value={box.name} data-price={box.price}>{box.name} — ${box.price} each</option>)}</select></label><label>Number of boxes<input id="box-count" name="quantity" type="number" min="10" step="1" value="10" required/></label><div class="estimate-result"><output id="estimate-total" aria-live="polite">$100</output><span>Merchandise estimate</span></div><p id="estimate-error" class="field-error" role="status"></p><button class="button" type="submit">Use this selection ↗</button><p class="small full">Not a confirmed quote. Any applicable tax and delivery are confirmed separately. Mixed box styles need individual review.</p></form>}
