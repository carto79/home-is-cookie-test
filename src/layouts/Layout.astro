---
import '../styles/original.css';
import '../styles/extensions.css';
import Reviews from '../components/Reviews.astro';
import {googleReviewUrl,googleProfileUrl} from '../data/reviews.js';
import {business} from '../data/site.js';
const {title,description,faqs=[],product=null}=Astro.props;
const path=Astro.url.pathname;
const canonical=business.origin+path;
const launch=import.meta.env.PUBLIC_SITE_LAUNCH==='true';
const indexable=launch && !['/prototype-notes/','/setup-guide/','/404','/404.html'].includes(path);
const nav=[['Menu','/cookies/'],['Corporate','/corporate-gifts/'],['Gallery','/gallery/'],['The Baker','/our-story/'],['Delivery','/ordering-delivery/']];
const graph=[{'@type':'Organization','@id':business.origin+'/#organization',name:business.name,url:business.origin,logo:business.origin+'/assets/logo.webp',email:business.email,description:'Cookies made from scratch and baked to order in Ruskin, Florida, including corporate cookie boxes and printed logo and photo cookies.',location:{'@type':'Place',name:'Ruskin, Florida'},founder:{'@id':business.origin+'/#latasha'},sameAs:[business.instagram,business.facebook],areaServed:['Ruskin, Florida','Sun City Center, Florida','Southern Hillsborough County, Florida','Valrico, Florida','Temple Terrace, Florida','Downtown Tampa, Florida']},{'@type':'Person','@id':business.origin+'/#latasha',name:'LaTasha',jobTitle:'Baker',url:business.origin+'/our-story/',worksFor:{'@id':business.origin+'/#organization'}},{'@type':'WebSite','@id':business.origin+'/#website',url:business.origin,name:business.name,publisher:{'@id':business.origin+'/#organization'}},{'@type':'WebPage','@id':canonical+'#page',url:canonical,name:title,description,isPartOf:{'@id':business.origin+'/#website'}}];
if(path!=='/' && !path.includes('prototype-notes'))graph.push({'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:business.origin+'/'},{'@type':'ListItem',position:2,name:title.split('|')[0].trim(),item:canonical}]});
if(path==='/sun-city-center-cookie-delivery/')graph.push({'@type':'Service','@id':canonical+'#service',name:'Cookie delivery to Sun City Center',serviceType:'Local cookie delivery by arrangement',provider:{'@id':business.origin+'/#organization'},areaServed:{'@type':'Place',name:'Sun City Center, Florida 33573'},description:'Regular delivery is $10 with a $20 minimum merchandise order. Address and date are confirmed before payment. Corporate delivery is quoted separately.',url:canonical});
if(faqs.length)graph.push({'@type':'FAQPage','@id':canonical+'#faq',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))});
if(product)graph.push({'@type':'Product',name:product.name,description:product.description,image:business.origin+'/assets/'+product.image+'.webp',brand:{'@id':business.origin+'/#organization'},offers:{'@type':'Offer',url:canonical,priceCurrency:'USD',price:product.price,seller:{'@id':business.origin+'/#organization'}}});
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta name="robots" content={indexable?'index,follow,max-image-preview:large':'noindex,nofollow'}/><meta name="theme-color" content="#0F2952"/><link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48"/><link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96"/><link rel="icon" type="image/png" href="/favicon-192x192.png" sizes="192x192"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="preload" href="/assets/cookie-display.woff" as="font" type="font/woff" crossorigin/><meta property="og:type" content="website"/><meta property="og:locale" content="en_US"/><meta property="og:site_name" content="Home is Cookie"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={business.origin+'/assets/social.jpg'}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={business.origin+'/assets/social.jpg'}/><meta property="og:image:alt" content="Home is Cookie — scratch-made cookies in Ruskin, Florida"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c')}/></head>
<body><a class="skip" href="#main">Skip to content</a>
<div class="AnnouncementBar">Made from scratch <span>•</span> Baked to order in Ruskin, FL <span>•</span> Sun City Center delivery by arrangement</div>
<header class="site-header"><div class="container header-inner"><a class="brand" href="/" aria-label="Home is Cookie — Home"><img src="/assets/logo.webp" width="52" height="52" alt="Home is Cookie logo"/><div><span class="brand-text">Home is Cookie.</span><span class="brand-sub">Scratch-made · Ruskin, FL</span></div></a><nav class="desktop-nav" aria-label="Main navigation">{nav.map(([label,url])=><a href={url} aria-current={path===url?'page':undefined}>{label}</a>)}</nav><a class="btn btn-primary header-order" href={business.jotform}>Order cookies</a><button class="mobile-toggle" id="menu-open" aria-controls="mobile-menu" aria-expanded="false">Menu <span aria-hidden="true">☰</span></button></div></header>
<dialog id="mobile-menu" class="mobile-menu" aria-label="Navigation"><button class="close" id="menu-close" aria-label="Close menu">Close ×</button><nav aria-label="Mobile navigation">{nav.map(([label,url])=><a href={url}>{label}</a>)}<a href="/stuffed-cookies/">Stuffed cookies</a><a href="/sandwich-cookies/">Sandwich cookies</a><a href="/cookie-cakes/">Cookie cakes</a><a href="/logo-cookies/">Logo & photo cookies</a><a class="btn btn-primary" href={business.jotform}>Order cookies</a></nav></dialog>
<main id="main"><slot/><section class="container" aria-labelledby="signup-title"><div class="insiders-box"><span class="eyebrow">A note from our kitchen</span><h2 id="signup-title">Good things are coming out of the oven.</h2><p>Get new flavors, seasonal ordering dates, and cookie gift ideas from Home is Cookie.</p><a class="btn btn-creme" href={business.kit} target="_blank" rel="noopener">Keep me in the loop ↗</a><p class="signup-note">Opens our Kit signup page · Occasional emails. Unsubscribe anytime.</p></div></section><Reviews/></main>
<footer class="site-footer" id="footer"><div class="container"><div class="footer-grid"><div><a class="footer-brand" href="/"><img src="/assets/logo.webp" width="64" height="64" alt="Home is Cookie logo"/><h2 class="footer-title">Home is Cookie</h2></a><p>Made from scratch. Baked to order in Ruskin, Florida.</p><div class="corridor-tags">Cookies · Corporate gifts · Printed logo cookies</div><nav class="footer-social" aria-label="Social profiles and reviews"><div class="social-icons"><a class="social-icon" href={business.instagram} target="_blank" rel="noopener" aria-label="Home is Cookie on Instagram"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a><a class="social-icon" href={business.facebook} target="_blank" rel="noopener" aria-label="Home is Cookie on Facebook"><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047v-2.66c0-3.026 1.792-4.698 4.533-4.698 1.312 0 2.686.236 2.686.236v2.971h-1.513c-1.49 0-1.956.931-1.956 1.887v2.264h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073Z"/></svg></a></div><div class="social-review-links"><a href={googleReviewUrl||googleProfileUrl} target="_blank" rel="noopener">Leave a Google review ↗</a><a href="https://www.facebook.com/homeiscookie/reviews" target="_blank" rel="noopener">Leave a Facebook review ↗</a>{!googleReviewUrl&&<span class="review-link-note">On Google, select “Write a review.”</span>}</div></nav></div><nav aria-label="Explore"><h2 class="footer-title">Explore</h2><a href="/cookies/">Sharing trays</a><a href="/stuffed-cookies/">Stuffed cookies</a><a href="/sandwich-cookies/">Sandwich cookies</a><a href="/cookie-cakes/">Cookie cakes</a><a href="/corporate-gifts/">Corporate gifts</a><a href="/logo-cookies/">Logo & photo cookies</a><a href="/gallery/">Photo gallery</a></nav><nav aria-label="Pickup delivery and contact"><h2 class="footer-title">Pickup & delivery</h2><p>Ruskin-area pickup by arrangement.<br/>Meeting details after confirmation.</p><a href="/sun-city-center-cookie-delivery/">Sun City Center delivery</a><a href="/ordering-delivery/">Ordering & delivery details</a><a href={'mailto:'+business.email}>{business.email}</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Home is Cookie</span><a href="/privacy/">Privacy</a><a href="/order-terms/">Order terms</a>{!launch&&<a href="/prototype-notes/">Owner review & setup guide ↗</a>}</div></div></footer><script src="../scripts/site.js"></script></body></html>
