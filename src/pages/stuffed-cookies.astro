---
import Layout from '../layouts/Layout.astro';import Photo from '../components/Photo.astro';import {stuffed} from '../data/site.js';
---
<Layout title="Stuffed Cookies in Ruskin | Home is Cookie" description="Explore three stuffed cookie flavors, baked to order in Ruskin. $5 each with a six-cookie minimum. Request pickup or local delivery.">
<section class="wrap page-hero split"><div><p class="eyebrow">THE GOOD PART IS INSIDE</p><h1>Stuffed cookies,<br/><em>baked to order.</em></h1><p>Choose Nutella-Filled Chocolate Chip, Dulce Doozy, or Biscoff-Filled Dulce de Leche. Request your flavors and date, and we’ll confirm availability before payment.</p><p>$5 each · minimum 6 cookies</p><a class="button" href="/order/?type=stuffed">Order stuffed cookies ↗</a></div><Photo src="stuffed" alt="A stuffed cookie broken open to reveal chocolate filling" class="photo" priority/></section>
<section class="section wrap" style="padding-top:20px"><h2>Choose your filled-cookie flavor.</h2><div class="flavor-menu">{stuffed.map(name=><div class="flavor-line">{name}<span>$5 each</span></div>)}</div><div class="split" style="margin-top:60px"><div><p class="eyebrow">SIX FOR NOW. TWELVE TO SHARE.</p><h2>How many should I order?</h2><p>Six stuffed cookies are $30. Twelve are $60. Delivery, where available, is additional. Flavor-mixing requests are confirmed individually.</p><div class="button-row"><a class="button" href="/order/?type=stuffed&quantity=6">Request 6 · $30 ↗</a><a class="button outline" href="/order/?type=stuffed&quantity=12">Request 12 · $60 ↗</a></div></div><Photo src="biscoff" alt="Cookies with Biscoff biscuits on a cooling rack" class="photo"/></div></section></Layout>
