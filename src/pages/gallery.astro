---
import Layout from '../layouts/Layout.astro';import {gallery} from '../data/site.js';const categories=['All',...new Set(gallery.map(i=>i.category))];
---
<Layout title="Cookie & Product Photo Gallery | Home is Cookie" description="Explore Home is Cookie product photographs: photo cookies, decorated cookies, stuffed cookies, and sandwich cookies. Find inspiration for your order.">
<section class="wrap page-hero"><p class="eyebrow">FROM OUR KITCHEN</p><h1>Cookies, celebrations,<br/>and <em>something to share.</em></h1><p class="intro">A closer look at Home is Cookie. Find an idea you like, then tell us what you’re planning.</p><p class="small">Product photographs shown for inspiration. Availability and final presentation are confirmed with your order.</p></section><section class="wrap section" style="padding-top:0"><div class="filter-bar" aria-label="Filter photographs">{categories.map((category,i)=><button data-filter={category} aria-pressed={i===0?'true':'false'}>{category}</button>)}</div><p class="small" id="gallery-status" aria-live="polite">Showing {gallery.length} photographs</p><div class="gallery-grid">{gallery.map((item,i)=><figure data-category={item.category}><button class="gallery-open" data-index={i} data-src={'/assets/'+item.src+'.webp'} data-alt={item.alt} data-caption={item.caption} aria-label={'Enlarge: '+item.alt}><img src={'/assets/'+item.src+'.webp'} alt={item.alt} width={item.width||1200} height={item.height||1200} loading="lazy"/><span aria-hidden="true">↗</span></button><figcaption>{item.caption}<a href={item.link}>Explore {item.category.toLowerCase()} ↗</a></figcaption></figure>)}</div><div class="callout"><h3>Have something in mind?</h3><p>Tell us which cookie or design caught your eye, along with your quantity and requested date.</p><a class="text-link" href="/order/">Plan something similar <span>↗</span></a></div></section><dialog id="lightbox" class="lightbox" aria-label="Product photograph"><button class="close" id="lightbox-close">Close ×</button><img id="lightbox-image" src="/assets/tray.webp" alt="" width="1200" height="900"/><div class="lightbox-bottom"><button id="lightbox-prev" aria-label="Previous photograph">←</button><p id="lightbox-caption"></p><button id="lightbox-next" aria-label="Next photograph">→</button></div></dialog></Layout>
