---
import Layout from '../layouts/Layout.astro';import FAQ from '../components/FAQ.astro';import Steps from '../components/Steps.astro';import {faqs} from '../data/site.js';
---
<Layout title="Ordering, Pickup & Delivery | Home is Cookie" description="Plan your cookie order: corporate notice, minimums, 50% deposit, Ruskin pickup, local delivery, allergens, packaging, and freshness guidance." faqs={faqs}>
<section class="wrap page-hero"><p class="eyebrow">LET’S MAKE SOMETHING GOOD HAPPEN</p><h1>Ordering, pickup,<br/><em>and delivery.</em></h1><p class="intro">Tell us what you’d like and when you need it. We confirm availability, your total, and pickup or delivery before payment.</p><a class="button" href="/order/">Start an order ↗</a></section><section class="corporate section"><div class="wrap split"><div><h2>Close to home.<br/>By arrangement.</h2><p>Ruskin, Sun City Center, and southern Hillsborough County, plus Valrico, Temple Terrace, and Downtown Tampa. Other Hillsborough County addresses are considered case by case.</p><a class="text-link" href="/sun-city-center-cookie-delivery/">Sun City Center delivery details <span>↗</span></a></div><div><h3>Regular delivery</h3><p>$10 delivery · $20 minimum merchandise order.<br/>Your address and date need confirmation.</p><h3>Corporate delivery & pickup</h3><p>Corporate delivery is quoted by order size and distance. Ruskin-area pickup meeting details are provided after confirmation.</p></div></div></section><Steps/><section class="section wrap faq-layout" style="padding-top:0"><div><p class="eyebrow">THE DETAILS, ALL IN ONE PLACE</p><h2>Your ordering<br/>questions, answered.</h2><p>For regular orders, contact us with your requested date so we can confirm availability.</p><a class="text-link" href="mailto:homeiscookie@gmail.com">Ask LaTasha a question <span>↗</span></a></div><FAQ/></section></Layout>
