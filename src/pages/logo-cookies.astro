---
import Layout from '../layouts/Layout.astro';import Photo from '../components/Photo.astro';import FAQ from '../components/FAQ.astro';import {faqs} from '../data/site.js';const items=[faqs[1],faqs[2]];
---
<Layout title="Custom Logo & Photo Cookies | Home is Cookie" description="Print your company logo, photo, or artwork on scratch-made cookies. $5 each, minimum 12; printing and artwork setup included." faqs={items} product={{name:'12 Logo or Photo Cookies',price:60,image:'logo-cookie',description:'Minimum order of 12 printed cookies at $5 each. Printing, artwork setup, and standard packaging included. Order subject to approval.'}}>
<section class="wrap page-hero split"><div><p class="eyebrow">A COOKIE WITH SOMETHING TO SAY</p><h1>Your logo or photo,<br/><em>printed on a cookie.</em></h1><p>Company logos, photographs, and artwork can be printed on Home is Cookie cookies. A personal detail for a company event, a thank-you, or a celebration.</p><p>$5 each · minimum 12 cookies · from $60</p><a class="button" href="/order/?type=logo&quantity=12">Request printed cookies ↗</a></div><Photo src="logo-cookie" alt="Home is Cookie logo printed on an iced cookie" class="photo" priority/></section>
<section class="section wrap split" style="padding-top:20px"><div><h2>What artwork<br/>should I send?</h2><p>Send the highest-resolution original file you have. Original artwork or a full-size photo is preferable to a screenshot or a compressed social-media image. We’ll review the file before confirming your order.</p><p>Printing and artwork setup are included. Standard packaging is provided.</p></div><div class="callout"><h3>Planning a corporate event?</h3><p>Please request corporate orders at least two weeks before your event. Include your quantity, date, and delivery location so we can confirm availability and the total.</p><a class="text-link" href="/corporate-gifts/">Compare corporate cookie boxes <span>↗</span></a></div></section><section class="section wrap faq-layout" style="padding-top:0"><h2>The details,<br/>before the design.</h2><FAQ items={items}/></section></Layout>
