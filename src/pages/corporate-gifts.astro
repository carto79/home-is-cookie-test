---
import Layout from '../layouts/Layout.astro';import Photo from '../components/Photo.astro';import Boxes from '../components/Boxes.astro';import Steps from '../components/Steps.astro';import FAQ from '../components/FAQ.astro';import {faqs} from '../data/site.js';const items=[faqs[0],faqs[2],faqs[3]];
---
<Layout title="Corporate Cookie Gifts in Tampa Bay | Home is Cookie" description="Scratch-made corporate cookie boxes from $10 each, minimum 10. Compare contents and plan logo cookies for clients, teams, and Tampa Bay events." faqs={items}>
<section class="wrap page-hero split"><div><p class="eyebrow">CLIENTS. COLLEAGUES. GOOD COMPANY.</p><h1>Corporate cookie gifts,<br/><em>made personal.</em></h1><p>Scratch-made cookie boxes and printed logo cookies from Ruskin, Florida. A thoughtful way to say thank you, welcome aboard, or well done.</p><div class="button-row"><a class="button" href="/order/?type=corporate">Request a corporate quote ↗</a></div><p class="small">Boxes: 10-box minimum · Logo cookies: 12-cookie minimum<br/>Please allow at least two weeks.</p></div><Photo src="logo-cookie" alt="Company logo example printed on a white iced cookie" class="photo" priority/></section>
<section class="corporate section"><div class="wrap"><p class="eyebrow">THREE WAYS TO SAY THANK YOU</p><h2>What comes in each box?</h2><p>Every corporate box includes one stuffed cookie plus mini cookies. Choose Sampler with four minis, Classic with six, or Party with eight. Boxes cost $10, $13, and $16 respectively, with a minimum order of 10 boxes.</p><Boxes estimator/></div></section>
<section class="wrap section split"><div><p class="eyebrow">A SMALL DETAIL. A PERSONAL TOUCH.</p><h2>Your brand,<br/>part of the occasion.</h2><p>Print a company logo, photograph, or artwork on cookies. Printing and artwork setup are included. Send the highest-resolution original file available.</p><p>$5 each · minimum 12 cookies · from $60</p><a class="text-link" href="/logo-cookies/">Explore logo & photo cookies <span>↗</span></a></div><div class="callout"><h3>Gifts for clients, teams, and events</h3><p>Choose boxes for individual gifts or printed cookies that put your logo into the occasion. Tell us whether you’re thanking clients, recognizing colleagues, or planning an event so we can confirm an order that fits.</p><p class="small">Standard packaging is included. Printed cookies are a separate offer; they are not automatically included in a corporate box.</p></div></section><Steps/><section class="section wrap faq-layout" style="padding-top:0"><h2>Before your<br/>company order.</h2><FAQ items={items}/></section></Layout>
