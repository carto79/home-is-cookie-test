---
import Layout from '../layouts/Layout.astro';import Photo from '../components/Photo.astro';import {cakes} from '../data/site.js';
---
<Layout title="Cookie Cakes in Ruskin, FL | Home is Cookie" description="Compare 12-, 14-, and 16-inch cookie cakes. Standard cakes from $35 and gourmet from $45, baked to order in Ruskin for your celebration.">
<section class="wrap page-hero split"><div><p class="eyebrow">MAKE ROOM AT THE CENTER OF THE TABLE</p><h1>A cookie cake<br/><em>for the occasion.</em></h1><p>Choose a 12-, 14-, or 16-inch cookie cake for your next celebration. Tell us your date and preferences so we can confirm your order.</p><a class="button" href="/order/?type=cake">Request a cookie cake ↗</a></div><Photo src="cake" alt="Round chocolate chip cookie cake decorated with piped frosting" class="photo" priority/></section>
<section class="section wrap" style="padding-top:20px"><h2>Compare sizes and prices.</h2><p>Standard cakes start at $35 and gourmet cakes start at $45. Tell us your guest count and we’ll help confirm a size, flavors, and finishing details.</p><div class="table-wrap"><table><caption class="small" style="text-align:left">Cookie cake merchandise prices</caption><thead><tr><th scope="col">Size</th><th scope="col">Standard</th><th scope="col">Gourmet</th></tr></thead><tbody>{cakes.map(c=><tr><th scope="row">{c.size} inches</th><td>${c.standard}</td><td>${c.gourmet}</td></tr>)}</tbody></table></div><p class="small">Availability, requested design, and pickup or delivery are confirmed before payment.</p></section></Layout>
